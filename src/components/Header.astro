---
import SectionContainer from "./SectionContainer.astro";
const estilo = "hover:text-emerald-300 transition-all ease-in-out duration-300 text-shadow-2xl";
---

<header class="flex justify-center items-center py-3 pt-12 fixed top-0 left-0 right-0 z-50  ">
    <nav class="flex flex-row gap-6 opacity-80 text-white/80 text-lg lg:text-xl bg-white/20 rounded-full px-4 py-2 backdrop-blur-lg shadow-lg overflow-x-auto whitespace-nowrap">
        <a class={estilo} href="#top">Inicio</a>
        <a class={estilo} href="#proyectos">Proyectos</a>
        <a class={estilo} href="#sobremi">Sobre mí</a>
        <a class={estilo} href="#contacto">Contacto</a>
    </nav>
</header>
