---
const PROJECTS = [
  {
    title: "Pomello ",
    date: "Mayo 2025",
    duration: "2 semanas",
    description:
      "Pomello es una herramienta de productividad que combina la gestión de proyectos al estilo Trello con la técnica Pomodoro. Pero más allá de su funcionalidad, ha sido un proyecto muy especial para mí.\n\nLo desarrollamos en tan solo 2 semanas desde cero. Fue mi primer proyecto Fullstack usando React Router, dnd-kit y otras tecnologías que hasta entonces apenas conocía. Crear un clon funcional de Trello en tan poco tiempo ha sido todo un desafío del que estoy muy orgulloso.\n\nAdemás, he trabajado especialmente el diseño de la interfaz, buscando una experiencia de usuario limpia, visual y fluida. El apartado estético ha sido principalmente ideado por mí, y creo que transmite bien el enfoque simple pero potente de la herramienta.\n\nHa sido una experiencia de aprendizaje muy gratificante.",
    image: "/projects/screenshot2.webp",
    link: "https://pomello.igoruve.com/",
    github: "https://github.com/Igoruve/pomello-fullstack",
    tags: [
      "React",
      "Tailwind",
      "MongoDB",
      "API Rest",
      "JavaScript",
      "dnd-kit",
      "JWT",
      "Local Storage",
    ],
  },
  {
    title: "Dungeons & Databases",
    date: "Abril-Mayo 2025",
    duration: "3 semanas",
    description:
      "Aplicación web Fullstack diseñada para fans de Dungeons and Dragons que buscan una herramienta completa y personalizable para gestionar sus campañas. Permite crear, editar y llevar un seguimiento detallado de personajes, con campos para estadísticas, habilidades, inventario y mucho más.\n\nHa sido un proyecto que desarrollé completamente por mi cuenta en apenas 3 semanas, desde cero. Fue también mi primera vez trabajando con MySQL, y el proceso me ha hecho aprender muchísimo, tanto a nivel de base de datos como de arquitectura general de una aplicación completa.\n\nAunque aún quedan algunas funcionalidades por implementar, estoy muy orgulloso del resultado. La interfaz es ligera, bien pensada, con animaciones fluidas gracias a Framer Motion, y con un enfoque muy centrado en la experiencia de usuario. Inspirado en D&D Beyond, pero buscando ir un paso más allá con opciones como notas personalizadas.",

    image: "/projects/screenshot.webp",
    link: "https://dnd.igoruve.com/",
    github: "https://github.com/Igoruve/dungeons-and-databases-frontend",
    tags: [
      "React",
      "Tailwind",
      "MySQL",
      "API Rest",
      "JavaScript",
      "Framer-motion",
      "JWT",
      "Local Storage",
    ],
  },
];
---

{
  PROJECTS.map((project) => (
    <article class="bg-slate-800 p-4 sm:p-6 rounded-lg my-12 sm:my-24 shadow-md">
      {project.link ? (
        <a href={project.link} target="_blank" rel="noopener noreferrer">
          <img
            src={project.image}
            alt={`Captura de pantalla del proyecto ${project.title}`}
            class="w-full h-60 sm:h-96 object-cover rounded-t-lg"
          />
        </a>
      ) : (
        <img
          src={project.image}
          alt={`Captura de pantalla del proyecto ${project.title}`}
          class="w-full h-60 sm:h-96 object-cover rounded-t-lg"
        />
      )}

      <h3 class="text-xl sm:text-2xl font-bold my-4 text-slate-100">
        {project.title}
      </h3>
      <p class="text-sm sm:text-base text-slate-500 mb-2">
        {project.date} | Duración: {project.duration}
      </p>

      <p class="text-base sm:text-lg whitespace-pre-line text-slate-400">
        {project.description}
      </p>

      <div class="flex flex-col sm:flex-row justify-between my-8 gap-2 sm:gap-0">
        {project.link ? (
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={project.link}
            class="text-emerald-500 underline"
          >
            Ver Proyecto
          </a>
        ) : (
          <span class="text-slate-500 text-md" />
        )}
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={project.github}
          class="text-emerald-500 underline"
        >
          Ver en GitHub
        </a>
      </div>

      <ul class="flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <li class=" text-gray-300 px-3 py-1 text-sm sm:text-base rounded-full">
            <span class="text-emerald-400 font-semibold"># </span> {tag}
          </li>
        ))}
      </ul>
    </article>
  ))
}
