---
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import perfil from "/public/fotoperfil.webp";
import Linkedin from "../components/icons/Linkedin.astro";
import GitHub from "../components/icons/GitHub.astro";
import Email from "../components/icons/Email.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Proyectos from "../components/Proyectos.astro";
import Code from "../components/icons/Code.astro";
import Person from "../components/icons/Person.astro";
import Sobremi from "../components/Sobremi.astro";
import Contacto from "../components/Contacto.astro";
import ScrollDown from "../components/ScrollDown.astro";
---

<Layout
  title="Igoruve Portfolio - Desarollador y Programador Frontend"
  description="Portfolio de igoruve, desarrollador y programador frontend. Especializado en interfaz y experiencia de usuario."
>
  <main>
    <Hero />
    <ScrollDown />

    <SectionContainer id="proyectos">
      <div class="flex flex-row gap-x-3 items-center text-white/90">
        <Code />
        <h2 class="text-3xl text-wrap">Proyectos</h2>
      </div>
      <a
        href="/casos/sistema-color"
        class="block bg-slate-800 p-4 sm:p-6 rounded-lg my-12 sm:my-24 shadow-md"
      >
        <div
          class="flex w-full h-28 sm:h-36 rounded-t-lg overflow-hidden"
          role="img"
          aria-label="Rampa de nueve pasos del verde de marca, del más claro al más oscuro"
        >
          <span class="flex-1" style="background:#E7F8EF"></span>
          <span class="flex-1" style="background:#C3EFD7"></span>
          <span class="flex-1" style="background:#90DFB5"></span>
          <span class="flex-1" style="background:#47D18C"></span>
          <span class="flex-1" style="background:#0FBD66"></span>
          <span class="flex-1" style="background:#009342"></span>
          <span class="flex-1" style="background:#00612A"></span>
          <span class="flex-1" style="background:#00451E"></span>
          <span class="flex-1" style="background:#032A15"></span>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold my-4 text-slate-100">
          Del color de marca a un sistema de tokens
        </h3>
        <p class="text-sm sm:text-base text-slate-500 mb-2">
          Septiembre 2026 | Ejercicio personal de diseño de sistemas
        </p>

        <p class="text-base sm:text-lg whitespace-pre-line text-slate-400">
          Un color de marca no es un sistema de color. Aquí convierto la
          identidad pública de Mercadona en una capa de tokens: la que responde
          qué verde exacto lleva un botón, un badge o una superficie.{"\n\n"}Nueve
          primitivos medidos, un mapeo semántico que da nombre y propósito a
          cada uno, y una pantalla real construida solo con esos tokens. Cada
          decisión viene con su ratio de contraste, para que todo el sistema se
          pueda auditar de un vistazo.
        </p>

        <div class="flex flex-col sm:flex-row justify-between my-8 gap-2 sm:gap-0">
          <span class="text-emerald-500 underline">Ver caso</span>
        </div>

        <ul class="flex flex-wrap gap-2">
          <li class="text-gray-300 px-3 py-1 text-sm sm:text-base rounded-full">
            <span class="text-emerald-400 font-semibold"># </span> Design tokens
          </li>
          <li class="text-gray-300 px-3 py-1 text-sm sm:text-base rounded-full">
            <span class="text-emerald-400 font-semibold"># </span> Accesibilidad
          </li>
          <li class="text-gray-300 px-3 py-1 text-sm sm:text-base rounded-full">
            <span class="text-emerald-400 font-semibold"># </span> WCAG
          </li>
          <li class="text-gray-300 px-3 py-1 text-sm sm:text-base rounded-full">
            <span class="text-emerald-400 font-semibold"># </span> Sistemas de diseño
          </li>
          <li class="text-gray-300 px-3 py-1 text-sm sm:text-base rounded-full">
            <span class="text-emerald-400 font-semibold"># </span> CSS
          </li>
        </ul>
      </a>

      <Proyectos />
    </SectionContainer>

    <SectionContainer
      id="sobremi"
      class="flex flex-col gap-3 text-white/90 w-full px-4 lg:w-[740px] mx-auto pt-0"
    >
      <div class="flex flex-row gap-x-3 items-center text-white/90">
        <Person />
        <h2 class="self-start text-2xl sm:text-3xl">Sobre mí</h2>
      </div>
      <Sobremi />
    </SectionContainer>

    <SectionContainer
      id="contacto"
      class="justify-center items-center flex flex-col gap-3 text-white/90 w-full px-4 lg:w-[740px] mx-auto pt-0 pb-24"
    >
      <Contacto />
    </SectionContainer>
  </main>
</Layout>
