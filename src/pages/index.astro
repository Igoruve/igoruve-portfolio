---
import Badge from "../components/Badge.astro";
import Layout from "../layouts/Layout.astro";
import perfil from "../assets/foto-perfil.jpg";
import Linkedin from "../components/icons/Linkedin.astro";
import GitHub from "../components/icons/GitHub.astro";
import Email from "../components/icons/Email.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Proyectos from "../components/Proyectos.astro";
import Code from "../components/icons/Code.astro";
---

<Layout
  title="Igoruve Portfolio - Desarollador y Programador Frontend"
  description="Portfolio de igoruve, desarrollador y programador frontend. Especializado en interfaz y experiencia de usuario."
>
  <main>
    <SectionContainer>
      <div class="flex flex-row gap-x-4 items-center mb-10">
        <img
          class="rounded-full w-20 h-20"
          src={perfil.src}
          alt="igoruve profile pic"
        />
        <Badge>Disponible para trabajar</Badge>
      </div>
      <h1 class="text-white text-5xl font-bold flex flex-row gap-x-4 pb-10">
        Holi, soy igoruve
      </h1>
      <h2 class="text-white/90 text-2xl text-wrap">
        <strong class="text-emerald-600">Desarrollador Frontend</strong> de Bilbao,
        <abbr title="España">ES.</abbr> Especializado en Interfaz y Experiencia de
        Usuario.
      </h2>
      <ul class="flex flex-row gap-x-4 mt-10">
        <li>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://github.com/Igoruve"
            class="flex flex-row items-center gap-x-2 border border-slate-900 rounded-full px-4 py-2 w-fit text-slate-900 bg-slate-100/30 shadow-md hover:bg-emerald-500 hover:text-white hover:scale-105 transition-all ease-in-out duration-300"
          >
            Github
            <GitHub />
          </a>
        </li>
        <li>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.linkedin.com/in/igorapariciosarmiento/"
            class="flex flex-row items-center gap-x-2 border border-slate-900 rounded-full px-4 py-2 w-fit text-slate-900 bg-slate-100/30 shadow-md hover:bg-emerald-500 hover:text-white hover:scale-105 transition-all ease-in-out duration-300"
          >
            Linkedin
            <Linkedin />
          </a>
        </li>
        <li>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="mailto:igoruve@gmail.com"
            class="flex flex-row items-center gap-x-2 border border-slate-900 rounded-full px-4 py-2 w-fit text-slate-900 bg-slate-100/30 shadow-md hover:bg-emerald-500 hover:text-white hover:scale-105 transition-all ease-in-out duration-300"
          >
            Email
            <Email />
          </a>
        </li>
      </ul>
    </SectionContainer>
    <SectionContainer id="proyectos">
      <div class="flex flex-row mb-24 gap-x-3 items-center text-white/90">
        <Code />
        <h2 class="text-3xl text-wrap">Proyectos</h2>
      </div>
      <Proyectos />
    </SectionContainer>
  </main>
</Layout>
