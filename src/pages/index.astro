---
import Badge from "../components/Badge.astro";
import Layout from "../layouts/Layout.astro";
import perfil from "/public/fotoperfil.webp";
import Linkedin from "../components/icons/Linkedin.astro";
import GitHub from "../components/icons/GitHub.astro";
import Email from "../components/icons/Email.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Proyectos from "../components/Proyectos.astro";
import Code from "../components/icons/Code.astro";
import Person from "../components/icons/Person.astro";

import Sobremi from "../components/Sobremi.astro";
import Contacto from "../components/Contacto.astro";
---

<Layout
  title="Igoruve Portfolio - Desarollador y Programador Frontend"
  description="Portfolio de igoruve, desarrollador y programador frontend. Especializado en interfaz y experiencia de usuario."
>
  <main>
    <section
      class="w-full h-screen flex justify-center items-center bg-[radial-gradient(125%_125%_at_50%_10%,#020618_40%,#10B981_100%)]"
    >
      <div class="px-4 w-full lg:w-[740px] mx-auto pt-24">
        <div class="flex flex-col sm:flex-row gap-4 items-center">
          <div class="relative group">
            <img
              class="rounded-full w-20 h-20 cursor-none"
              src={perfil.src}
              alt="igoruve profile pic"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 text-sm bg-emerald-500 text-white rounded opacity-0 group-hover:opacity-90 transition-opacity duration-300 whitespace-nowrap"
            >
              Uy! :D
            </div>
          </div>

          <Badge>Disponible para trabajar</Badge>
        </div>
        <div class="text-center sm:text-start mt-6">
          <h1 class="text-white text-4xl sm:text-5xl font-bold mb-4">
            Holi, soy igoruve
          </h1>
          <h2 class="text-white/90 text-xl sm:text-2xl">
            <strong class="text-emerald-600">Desarrollador Frontend</strong> de Bilbao.
            <br />
            Especializado en Interfaz y Experiencia de Usuario.
          </h2>
        </div>
        <Contacto />
      </div>
    </section>

    <SectionContainer id="proyectos">
      <div class="flex flex-row gap-x-3 items-center text-white/90">
        <Code />
        <h2 class="text-3xl text-wrap">Proyectos</h2>
      </div>
      <Proyectos />
    </SectionContainer>
    <div
      id="sobremi"
      class="flex flex-col gap-3 text-white/90 w-full px-4 lg:w-[740px] mx-auto pt-0"
    >
      <div class="flex flex-row gap-x-3 items-center text-white/90">
        <Person />
        <h2 class="self-start text-2xl sm:text-3xl">Sobre mí</h2>
      </div>
      <Sobremi />
    </div>

    <div
      id="contacto"
      class="justify-center items-center flex flex-col gap-3 text-white/90 w-full px-4 lg:w-[740px] mx-auto pt-0 pb-24"
    >
      <Contacto />
    </div>
  </main>
</Layout>
